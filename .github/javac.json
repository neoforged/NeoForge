{
    "problemMatcher": [
        {
            "owner": "neoforge-javac",
            "pattern": [
                {
                    "regexp": "^([^:]+):(\\d+): (warning|error): (.+?)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                },
                {
                    "regexp": "^(?! +\\^)(.+?)$",
                    "code": 1,
                    "loop": true
                }
            ]
        }
    ]
}
