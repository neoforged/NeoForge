+    /// Neo: {@return a pack generator for a builtin datapack with the given pack ID under the given namespace}
+    public PackGenerator getBuiltinDatapack(boolean run, String namespace, String packId) {
+        Path packPath = this.vanillaPackOutput.getOutputFolder(PackOutput.Target.DATA_PACK).resolve(namespace).resolve("datapacks").resolve(packId);
+        return new PackGenerator(run, namespace + '_' + packId, new PackOutput(packPath));
+    }
+
+    /// Neo: {@return an unmodifiable view of the data providers to be run}
+    public Map<String, DataProvider> getProvidersView() {
+        return java.util.Collections.unmodifiableMap(this.providersToRun);
+    }
+
+    /// Neo: {@return the default pack output}
+    public PackOutput getPackOutput() {
+        return this.vanillaPackOutput;
+    }
+
+    /// Neo: {@return a pack output for the given path}
+    public PackOutput getPackOutput(String path) {
+        return new PackOutput(this.vanillaPackOutput.getOutputFolder().resolve(path));
+    }
+
+    /// Neo: {@return a pack generator with the given provider prefix, writing to the given path}
+    public PackGenerator getPackGenerator(boolean run, String providerPrefix, String path) {
+        return this.getPackGenerator(run, providerPrefix, this.getPackOutput(path));
+    }
+
+    /// Neo: {@return a pack generator with the given provider prefix, writing to the given output}
+    public PackGenerator getPackGenerator(boolean run, String providerPrefix, PackOutput output) {
+        return new PackGenerator(run, providerPrefix, output);
+    }
+
+    /// Neo: add the data provider created with the default pack output by the given factory
+    public <T extends DataProvider> T addProvider(boolean run, DataProvider.Factory<T> factory) {
+        return this.addProvider(run, factory.create(this.vanillaPackOutput));
+    }
+
+    /// Neo: add the given data provider
+    public <T extends DataProvider> T addProvider(boolean run, T provider) {
+        String id = provider.getName();
+        if (!DataGenerator.this.allProviderIds.add(id)) {
+            throw new IllegalStateException("Duplicate provider: " + id);
+        }
+        if (run) {
+            DataGenerator.this.providersToRun.put(id, provider);
+        }
+        return provider;
+    }
+
+    /// Neo: merge the given data generator into this one
+    public void merge(DataGenerator other) {
+        other.providersToRun.forEach((id, provider) -> {
+            if (!this.allProviderIds.add(id)) {
+                throw new IllegalStateException("Duplicate provider: " + id);
+            }
+            this.providersToRun.put(id, provider);
+        });
+
+        other.providersToRun.clear();
+        other.allProviderIds.clear();
+    }
+
