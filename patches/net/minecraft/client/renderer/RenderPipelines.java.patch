     public static List<RenderPipeline> optionalPipelines() {
         return OPTIONAL_PIPELINES_BY_LOCATION.values().stream().toList();
     }
+
+    @org.jetbrains.annotations.ApiStatus.Internal
+    public static void registerCustomPipelines() {
+        var event = new net.neoforged.neoforge.client.event.RegisterRenderPipelinesEvent((pipeline, optional) -> {
+            var registry = optional ? OPTIONAL_PIPELINES_BY_LOCATION : PIPELINES_BY_LOCATION;
+            if (registry.putIfAbsent(pipeline.getLocation(), pipeline) != null) {
+                throw new IllegalStateException("Duplicate RenderPipeline registration for location: " + pipeline.getLocation());
+            }
+        });
+        net.neoforged.fml.ModLoader.postEvent(event);
+    }
